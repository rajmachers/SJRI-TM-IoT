# Generated by configure-domain.sh
# Domain: {{DOMAIN}}

limit_req_zone  $binary_remote_addr zone=req_zone:10m    rate=20r/s;
limit_conn_zone $binary_remote_addr zone=conn_zone:10m;
limit_req_zone  $binary_remote_addr zone=ws_zone:10m     rate=100r/s;
limit_conn_zone $binary_remote_addr zone=conn_zone_ws:10m;

server {
    listen 80;
    server_name {{DOMAIN}};
    return 301 https://{{DOMAIN}}$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{DOMAIN}};

    ssl_certificate     {{SSL_CERT}};
    ssl_certificate_key {{SSL_KEY}};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 200M;
    client_body_buffer_size 200M;

    access_log /var/log/nginx/{{DOMAIN}}_ws.log;

    # ── Live Dashboard ────────────────────────────────────────────────────
    location = /live {
        return 301 /live/;
    }

    location ^~ /live/ {
        proxy_pass http://127.0.0.1:{{LIVE_PORT}}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # ── WebSockets ────────────────────────────────────────────────────────
    location /api/ws {
        limit_req  zone=ws_zone;
        limit_conn conn_zone_ws 100;
        proxy_pass http://127.0.0.1:{{TB_HTTP_PORT}}/api/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600;
    }

    location /api/v1/ws {
        limit_req  zone=ws_zone;
        limit_conn conn_zone_ws 100;
        proxy_pass http://127.0.0.1:{{TB_HTTP_PORT}}/api/v1/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600;
    }

    # ── Static assets (no rate limit) ─────────────────────────────────────
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|otf)$ {
        proxy_pass http://127.0.0.1:{{TB_HTTP_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # ── API (rate-limited) ────────────────────────────────────────────────
    location /api/ {
        limit_req  zone=req_zone burst=50 nodelay;
        limit_conn conn_zone 50;
        proxy_pass http://127.0.0.1:{{TB_HTTP_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # ── ThingsBoard UI ────────────────────────────────────────────────────
    location / {
        proxy_pass http://127.0.0.1:{{TB_HTTP_PORT}}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_buffers 8 16M;
        proxy_busy_buffers_size 24M;
    }

    location /health {
        proxy_pass http://127.0.0.1:{{TB_HTTP_PORT}}/health;
    }
}
